{
  "name": "taskmanager-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "_moduleAliases": {
    "@": "./dist"
  },
  "scripts": {
    "test": "jest",
    "build": "tsc -p tsconfig.json",
    "start": "node -r module-alias/register ./dist/index.js",
    "start:dev": "nodemon --watch src -r tsconfig-paths/register ./src/index.ts",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/index.ts",
    "migrate": "ts-node scripts/migrate-mongodb.ts",
    "migrate:init": "ts-node scripts/migrate-mongodb.ts",
    "migrate:update": "ts-node scripts/migrate-schema-updates.ts",
    "migrate:run": "node scripts/run-migration.js",
    "docker:build": "docker build -t sejobs-backend .",
    "docker:run": "docker run -p 3000:3000 sejobs-backend",
    "docker:compose:up": "docker-compose up",
    "docker:compose:down": "docker-compose down",
    "gen-db": "npx supabase gen types typescript --project-id cpkzdkklmowjgvtzqvoh > src/types/database.ts",
    "migrate:seed": "psql \"$DATABASE_URL\" -f ./db/migrations/001_seed_jobs.sql",
    "seed": "ts-node -r tsconfig-paths/register src/scripts/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
